# Root-level compose settings. Copy this file to `.env` before running docker compose.
# This .env is the single source of truth for PostgreSQL credentials - docker-compose.yml
# forwards POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB into the backend container too,
# so you never have to keep two copies of the database password in sync.

# Ports exposed on your host machine
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=5173

# PostgreSQL credentials
POSTGRES_USER=twofa_app
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=twofa_example
