NODE_ENV=development
PORT=4000

# Leave "false" unless this backend sits behind a real reverse proxy (e.g. nginx).
# Setting it otherwise with no actual proxy in front lets any client spoof
# X-Forwarded-For and forge req.ip, defeating IP-based rate limiting/lockout and
# the audit log's ip_address field. If you do add a reverse proxy, set this to the
# number of hops it represents (usually "1").
TRUST_PROXY=false

# Database connection. "postgres" matches the docker-compose service name.
# When running via `docker compose up`, DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME are
# actually injected from the root .env file (see docker-compose.yml) - the values below
# only take effect if you run the backend directly on your host (outside Docker).
DB_HOST=postgres
DB_PORT=5432
DB_USER=twofa_app
DB_PASSWORD=change_me_to_a_strong_password
DB_NAME=twofa_example

# JWT signing secrets. Use three DIFFERENT random values so a leaked token of one
# type can never be replayed as another type. Generate each with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_64
REFRESH_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_64
PRE_AUTH_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_64
SSO_STATE_SECRET=replace_with_output_of_openssl_rand_hex_64

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PRE_AUTH_TOKEN_TTL=5m

# AES-256-GCM key used to encrypt TOTP secrets at rest (64 hex chars = 32 bytes).
# TOTP secrets cannot be one-way hashed like passwords because the server must
# recover the original value to verify future codes, so they are encrypted instead.
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32

TWOFA_ISSUER=2FA Example

# Set to "true" only when the app is served over HTTPS (required for Secure cookies).
COOKIE_SECURE=false

# Origin allowed to call the API with credentials (CORS). Used when the frontend
# is not served through the Vite dev proxy (e.g. a separate static deployment).
FRONTEND_ORIGIN=http://localhost:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Bootstrap admin account, created automatically on first startup if no admin
# user exists yet. The password is hashed before storage; change it after first login
# (the account is forced to change its password on first login anyway).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_immediately!1
ADMIN_FULL_NAME=System Administrator

# Convenience plain "user" role account, seeded alongside the admin account so
# there's a ready-made login to test/demo RBAC with (confirming the admin-only
# menus and endpoints are actually hidden/denied for a non-admin). Unlike the
# admin account this is NOT forced to change its password - it's meant to be
# used as-is for quick testing. Remove or change it before any real deployment.
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=UserTest123
TEST_USER_FULL_NAME=Test User

# ---------------------------------------------------------------------------
# Single Sign-On (SSO) providers - all optional. Each is independently toggled
# and, if enabled but missing required values below, is logged as disabled at
# startup rather than crashing the app. An external identity provider only
# ever establishes *who* the user is - it does not skip this app's own
# mandatory local 2FA, which still runs immediately afterwards for every SSO
# login exactly as it does for password logins. See README.md for how to
# obtain credentials from each provider's developer console.
# ---------------------------------------------------------------------------

# Facebook Login (plain OAuth 2.0 - create an app at https://developers.facebook.com,
# add "Facebook Login" product, and register the redirect URI printed by
# GET /api/auth/sso/facebook/start's provider config, i.e.
# http://localhost:5173/api/auth/sso/facebook/callback)
FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# LINE Login (OpenID Connect - create a channel at https://developers.line.biz,
# enable "OpenID Connect", and register the redirect URI
# http://localhost:5173/api/auth/sso/line/callback)
LINE_ENABLED=false
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Keycloak (OpenID Connect). Point ISSUER_URL at how the *backend* reaches it.
# Only set PUBLIC_ISSUER_URL when that differs from what the *browser* must use
# (this is the case for the docker-compose.keycloak.yml addon - see its .env
# additions). ALLOW_INSECURE permits plain http:// issuers and should only ever
# be used for local/dev Keycloak instances, never a real deployment.
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER_URL=
KEYCLOAK_PUBLIC_ISSUER_URL=
KEYCLOAK_ALLOW_INSECURE=false
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Generic OpenID Connect - use this for any other OIDC-compliant IdP (Google,
# Auth0, Okta, Azure AD, another Keycloak realm, ...). DISPLAY_NAME is just the
# label shown on the login button. Register the redirect URI
# http://localhost:5173/api/auth/sso/oidc/callback with the provider.
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=OIDC Provider
OIDC_ISSUER_URL=
OIDC_PUBLIC_ISSUER_URL=
OIDC_ALLOW_INSECURE=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
