NODE_ENV=development
PORT=4000

# Database connection. "postgres" matches the docker-compose service name.
# When running via `docker compose up`, DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME are
# actually injected from the root .env file (see docker-compose.yml) - the values below
# only take effect if you run the backend directly on your host (outside Docker).
DB_HOST=postgres
DB_PORT=5432
DB_USER=twofa_app
DB_PASSWORD=change_me_to_a_strong_password
DB_NAME=twofa_example

# JWT signing secrets. Use three DIFFERENT random values so a leaked token of one
# type can never be replayed as another type. Generate each with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_64
REFRESH_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_64
PRE_AUTH_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_64

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
PRE_AUTH_TOKEN_TTL=5m

# AES-256-GCM key used to encrypt TOTP secrets at rest (64 hex chars = 32 bytes).
# TOTP secrets cannot be one-way hashed like passwords because the server must
# recover the original value to verify future codes, so they are encrypted instead.
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32

TWOFA_ISSUER=2FA Example

# Set to "true" only when the app is served over HTTPS (required for Secure cookies).
COOKIE_SECURE=false

# Origin allowed to call the API with credentials (CORS). Used when the frontend
# is not served through the Vite dev proxy (e.g. a separate static deployment).
FRONTEND_ORIGIN=http://localhost:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Bootstrap admin account, created automatically on first startup if no admin
# user exists yet. The password is hashed before storage; change it after first login
# (the account is forced to change its password on first login anyway).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_immediately!1
ADMIN_FULL_NAME=System Administrator
